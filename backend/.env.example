DATABASE_URL='postgresql://neondb_owner:npg_iEMzsFWy23aK@ep-red-butterfly-amnsw1f7-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'
JWT_SECRET="change-this-secret"
JWT_REFRESH_SECRET="change-this-refresh-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_REFRESH_EXPIRES_MS=2592000000
PORT=4000

# YooKassa (MVP friendly defaults)
# Для диплома можно стартовать в mock-режиме без реального договора YooKassa.
YOOKASSA_MODE="mock" # mock | sandbox | live (при отсутствии ключей автоматически уйдет в mock)
YOOKASSA_SHOP_ID="100500"
YOOKASSA_SECRET_KEY="test_secret"
YOOKASSA_RETURN_URL="http://localhost:3001/checkout/return"

# Webhook: https://yookassa.ru/developers/using-api/webhooks
# URL в личном кабинете: https://<ваш-домен>/checkout/yookassa/webhook
YOOKASSA_WEBHOOK_SKIP_IP_CHECK="true"
# Для локальной отладки webhook без IP YooKassa (заголовок X-Yookassa-Webhook-Dev-Secret)
YOOKASSA_WEBHOOK_DEV_SECRET="dev-webhook-secret"

# Уведомления администратору о новых заказах (SMTP mail.ru)
# SMTP_USER — ящик-отправитель; ADMIN_ORDER_NOTIFICATION_EMAIL — куда приходит письмо.
# SMTP_PASS — «Пароль для внешнего приложения» в настройках Mail.ru (не пароль от входа).
# При таймауте на 465 попробуйте SMTP_PORT=587.
ADMIN_ORDER_NOTIFICATION_EMAIL="katet.tetet@mail.ru"
SMTP_HOST="smtp.mail.ru"
SMTP_PORT="465"
SMTP_USER="your-sender@mail.ru"
SMTP_PASS="your-app-password"
SMTP_FROM="your-sender@mail.ru"
